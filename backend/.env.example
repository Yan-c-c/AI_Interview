# Set a random signing secret to keep sessions valid across restarts and workers.
ADMIN_AUTH_SECRET=
# To create the initial administrator, set both values before first login.
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# DeepSeek / OpenAI-compatible LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=
SMART_MODEL=
FAST_MODEL=

# Report sharing SMTP
WUZIQI_SMTP_HOST=smtp.example.com
WUZIQI_SMTP_PORT=465
WUZIQI_SMTP_USER=
WUZIQI_SMTP_PASSWORD=
WUZIQI_SMTP_FROM=
WUZIQI_SMTP_SSL=1
WUZIQI_SMTP_TLS=0

# Generic SMTP aliases for CoverLetterAgent email sending
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=1
SMTP_USE_TLS=0

# Baidu speech service
BAIDU_SPEECH_APP_NAME=面试助手
BAIDU_SPEECH_APP_DESCRIPTION=面试助手
BAIDU_SPEECH_APP_ID=
BAIDU_SPEECH_API_KEY=
BAIDU_SPEECH_SECRET_KEY=

# Baidu audio-file transcription. pid=8953 enables speaker diarization.
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=
BAIDU_ASR_BASE_URL=https://aip.baidubce.com
BAIDU_ASR_PID=8953
BAIDU_ASR_RATE=16000
BAIDU_ASR_FORMAT=mp3
BAIDU_ASR_POLL_INTERVAL_SECONDS=3
BAIDU_ASR_POLL_TIMEOUT_SECONDS=45
BAIDU_ASR_PUBLIC_AUDIO_BASE_URL=

# Baidu AI Search for public answer evidence
BAIDU_AI_SEARCH_API_KEY=
BAIDU_AI_SEARCH_BASE_URL=https://qianfan.baidubce.com/v2/ai_search/chat/completions
BAIDU_AI_SEARCH_MODEL=ernie-4.5-turbo-32k
BAIDU_AI_SEARCH_SOURCE=baidu_search_v1
BAIDU_AI_SEARCH_MAX_RESULTS=5
BAIDU_AI_SEARCH_TIMEOUT_SECONDS=30

# Aliyun OSS is used to expose locally uploaded interview audio to Baidu ASR.
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_PREFIX=interview-audio/
ALIYUN_OSS_PUBLIC_READ=0
ALIYUN_OSS_SIGNED_URL_EXPIRES_SECONDS=7200

# Embedded interview knowledge base / RAG configuration
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_TOP_K=8
LIGHTRAG_CHUNK_TOP_K=8
LIGHTRAG_TIMEOUT_SECONDS=8
LIGHTRAG_INPUT_DIR=./data/interview_kb/inputs
LIGHTRAG_WORKING_DIR=./data/interview_kb/rag_storage
LIGHTRAG_SERVER_HOST=127.0.0.1
LIGHTRAG_SERVER_PORT=9621
LIGHTRAG_LLM_BINDING=openai
LIGHTRAG_LLM_BINDING_HOST=https://api.deepseek.com/v1
LIGHTRAG_LLM_MODEL=deepseek-chat
LIGHTRAG_EMBEDDING_BINDING=openai
LIGHTRAG_EMBEDDING_BINDING_HOST=
LIGHTRAG_EMBEDDING_MODEL=
LIGHTRAG_RERANK_BINDING=null
LIGHTRAG_RERANK_MODEL=
LIGHTRAG_RERANK_BINDING_HOST=
LIGHTRAG_RERANK_BINDING_API_KEY=
LIGHTRAG_MAX_GRAPH_NODES=500
LIGHTRAG_SUMMARY_LANGUAGE=Chinese
LIGHTRAG_CHUNK_SIZE=1200
LIGHTRAG_CHUNK_OVERLAP_SIZE=100
LIGHTRAG_MAX_ASYNC=4
LIGHTRAG_MAX_PARALLEL_INSERT=2

# Salary negotiation Agent. Model files are optional; when absent the Agent
# falls back to demo benchmark data + DeepSeek strategy generation.
SALARY_DATA_PATH=./data/salary_system
SALARY_PROCESSED_DATA_PATH=./data/salary_system/processed
SALARY_MODEL_DIR=./data/salary_system/models
SALARY_MODEL_PATH=./data/salary_system/models/xgboost_optimized.pkl
SALARY_TREND_MODEL_PATH=./data/salary_system/models/lstm_trend.keras
SALARY_RL_MODEL_PATH=./data/salary_system/models/rl_negotiation
SALARY_WORD2VEC_MODEL_PATH=./data/salary_system/processed/skills_word2vec.model
SALARY_ENABLE_RL_SIMULATION=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
